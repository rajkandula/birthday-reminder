# Copy to .env.local for local development. On Harakumo, add the same values in
# Project → Environment (or let `npm run deploy` sync them for you).

# Harakumo API key (Settings → API keys). Server-side only.
HARAKUMO_API_KEY=hk_live_your_key_here
# Numeric id of your Harakumo project (shown in the project's dashboard).
HARAKUMO_PROJECT_ID=
# Numeric id of the Edge SQLite database Wishly stores its data in (Project → Databases).
HARAKUMO_DATABASE_ID=
# Optional: the Harakumo API origin. Defaults to https://harakumo.com.
HARAKUMO_BASE_URL=

# Signs session cookies: openssl rand -base64 48
AUTH_SECRET=
# Protects the dispatcher (/api/cron/dispatch and the cron edge function): openssl rand -hex 24
CRON_SECRET=

# Public URL of the app (optional; `npm run deploy` fills it in from the project).
APP_URL=http://localhost:3000
# Optional, deploy only: the URL to sync as APP_URL, e.g. your own domain.
PRODUCTION_APP_URL=

# Background scheduler: on by default in production, off by default in development.
# WISHLY_SCHEDULER=on
